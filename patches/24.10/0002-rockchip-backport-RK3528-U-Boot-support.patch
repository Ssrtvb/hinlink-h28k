++	chosen {
++		u-boot,spl-boot-order = "same-as-spl", &sdmmc, &sdhci;
++	};
++
++	dmc {
++		compatible = "rockchip,rk3528-dmc";
++		bootph-all;
++	};
++
++	soc {
++		rng: rng@ffc50000 {
++			compatible = "rockchip,rkrng";
++			reg = <0x0 0xffc50000 0x0 0x200>;
++		};
++
++		otp: nvmem@ffce0000 {
++			compatible = "rockchip,rk3528-otp";
++			reg = <0x0 0xffce0000 0x0 0x4000>;
++		};
