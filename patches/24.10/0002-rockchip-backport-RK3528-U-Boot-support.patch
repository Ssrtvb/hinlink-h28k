++		param_write(priv->phy_grf, &cfg->pipe_txcomp_sel, false);
++		param_write(priv->phy_grf, &cfg->pipe_txelec_sel, false);
++		param_write(priv->phy_grf, &cfg->usb_mode_set, true);
++		param_write(priv->pipe_grf, &cfg->u3otg0_port_en, true);
