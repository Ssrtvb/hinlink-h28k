++			clock-names = "biu", "ciu";
++			fifo-depth = <0x100>;
++			interrupts = <GIC_SPI 133 IRQ_TYPE_LEVEL_HIGH>;
++			max-frequency = <150000000>;
++			pinctrl-names = "default";
++			pinctrl-0 = <&sdmmc_bus4>, <&sdmmc_clk>, <&sdmmc_cmd>,
++				    <&sdmmc_det>;
++			resets = <&cru SRST_H_SDMMC0>;
++			reset-names = "reset";
++			rockchip,default-sample-phase = <90>;
++			status = "disabled";
++		};
++	};
++};
++
