++static int rkrng_init(struct udevice *dev)
++{
++	struct rk_rng_plat *pdata = dev_get_priv(dev);
++	u32 reg = 0;
++
++	rk_clrreg(pdata->base + RKRNG_CTRL, 0xffff);
