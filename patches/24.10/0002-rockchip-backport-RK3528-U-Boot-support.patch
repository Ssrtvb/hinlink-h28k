++#define RKRNG_STATE_SW_TRNG_ACK			BIT(4)
++
++/* DRNG_DATA_0 ~ DNG_DATA_7 */
++#define RKRNG_DRNG_DATA_0			0x0070
++#define RKRNG_DRNG_DATA_7			0x008C
