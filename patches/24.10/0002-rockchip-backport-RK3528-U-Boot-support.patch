++		/* Enable adaptive CTLE for USB3.0 Rx */
++		val = readl(priv->mmio + 0x200);
++		val &= ~GENMASK(17, 17);
++		val |= 0x01 << 17;
++		writel(val, priv->mmio + 0x200);
++
++		/* Set Rx squelch input filler bandwidth */
++		val = readl(priv->mmio + 0x20c);
++		val &= ~GENMASK(2, 0);
++		val |= 0x06;
++		writel(val, priv->mmio + 0x20c);
