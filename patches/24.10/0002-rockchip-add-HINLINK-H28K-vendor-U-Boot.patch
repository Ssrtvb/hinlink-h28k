diff --git a/package/boot/uboot-rk35xx/patches/003-adc-raw-to-uv-api.patch b/package/boot/uboot-rk35xx/patches/003-adc-raw-to-uv-api.patch
new file mode 100644
index 00000000000..6fdcd0aabb6
--- /dev/null
+++ b/package/boot/uboot-rk35xx/patches/003-adc-raw-to-uv-api.patch
@@ -0,0 +1,62 @@
+Index: rk-u-boot/drivers/adc/adc-uclass.c
+===================================================================
+--- rk-u-boot.orig/drivers/adc/adc-uclass.c
++++ rk-u-boot/drivers/adc/adc-uclass.c
+@@ -7,6 +7,7 @@
+ 
+ #include <common.h>
+ #include <errno.h>
++#include <div64.h>
+ #include <dm.h>
+ #include <dm/lists.h>
+ #include <dm/device-internal.h>
+@@ -365,6 +366,30 @@ nodev:
+ 
+ 	return 0;
+ }
++
++int adc_raw_to_uV(struct udevice *dev, unsigned int raw, int *uV)
++{
++	unsigned int data_mask;
++	int ret, val, vref;
++	u64 raw64 = raw;
++
++	ret = adc_vdd_value(dev, &vref);
++	if (ret)
++		return ret;
++
++	if (!adc_vss_value(dev, &val))
++		vref -= val;
++
++	ret = adc_data_mask(dev, &data_mask);
++	if (ret)
++		return ret;
++
++	raw64 *= vref;
++	do_div(raw64, data_mask);
++	*uV = raw64;
++
++	return 0;
++}
+ 
+ static int adc_vdd_platdata_set(struct udevice *dev)
+ {
